# Copy to .env (git-ignored) and fill in before building a release.

# The app's Google OAuth client, type "Desktop app" — see docs/GOOGLE_SETUP.md.
# Built into the app so users only click "Link Google Calendar".
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Khatwa accounts — Neon Auth. See docs/ACCOUNTS.md. Leave empty to run without accounts.
MAIN_VITE_NEON_AUTH_URL=
# Only if Neon Auth rejects requests with "invalid origin": a trusted domain you added in Neon.
MAIN_VITE_NEON_AUTH_ORIGIN=
