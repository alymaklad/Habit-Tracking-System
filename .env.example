# Copy to .env.local for development. On Vercel, set these in Project → Settings →
# Environment Variables. docs/DEPLOY.md walks through each one.

# --- Required -------------------------------------------------------------------------

# Neon Postgres. Use the DIRECT (unpooled) connection string: each request sets its
# account's schema on the session, which PgBouncer's transaction mode would drop.
# The Neon ↔ Vercel integration sets DATABASE_URL_UNPOOLED for you; that is used first.
DATABASE_URL=

# Neon Auth (Neon console → Auth). Add this site's URL to its trusted domains.
NEON_AUTH_URL=

# 32+ random characters. Seals session cookies, Google tokens and pasted AI keys.
# Changing it signs everyone out and unlinks Google. `openssl rand -base64 48`
APP_SECRET=

# Vercel sends this as a Bearer token to the daily cron. `openssl rand -hex 32`
CRON_SECRET=

# --- Recommended ----------------------------------------------------------------------

# The public URL, e.g. https://khatwa.vercel.app. Fixes the origin used for Google
# redirects and Neon Auth; without it the request's own host is used.
APP_URL=

# Private Vercel Blob store for journal attachments (Storage → Blob → connect to the
# project sets this). Without it, uploads go to .data/ — fine locally, lost on Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Optional -------------------------------------------------------------------------

# Google Tasks + Calendar sync. An OAuth client of type "Web application" with
# <APP_URL>/api/google/callback as an authorised redirect URI. See docs/GOOGLE_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A server-wide AI key, used by anyone who has not pasted their own in Settings.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Plans per day on the server's key: per signed-in user, and per IP for guests.
AI_DAILY_LIMIT=30
GUEST_AI_PER_DAY=3

# --- Development only -----------------------------------------------------------------

# With no NEON_AUTH_URL, `npm run dev` can skip accounts and use one local user.
# (Ignored on Vercel.) `npm run dev` without DATABASE_URL keeps data in .data/pglite.
KHATWA_DEV_USER=
