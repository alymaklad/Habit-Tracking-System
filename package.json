{
  "name": "khatwa",
  "version": "0.1.0",
  "description": "Khatwa — a habit tracker with streaks, XP, AI goal planning and Google Tasks sync, hosted on Vercel with Neon Postgres",
  "author": "Aly Tarek Maklad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint src/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:desktop": "node --import tsx scripts/importDesktop.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.11",
    "luxon": "^3.7.2",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
